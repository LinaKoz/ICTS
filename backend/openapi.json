{
  "openapi": "3.1.0",
  "info": {
    "title": "ICTS Rostering API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Meta",
        "operationId": "get_meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Logout Api Auth Logout Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsvAliasesOut": {
        "properties": {
          "header_aliases": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Header Aliases"
          },
          "role_aliases": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Role Aliases"
          },
          "status_aliases": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Status Aliases"
          }
        },
        "type": "object",
        "required": [
          "header_aliases",
          "role_aliases",
          "status_aliases"
        ],
        "title": "CsvAliasesOut",
        "description": "P14 documented header and value aliases."
      },
      "DemandEntry": {
        "properties": {
          "shift": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ],
            "title": "Shift"
          },
          "role": {
            "type": "string",
            "enum": [
              "GENERAL_GUARD",
              "SCREENER",
              "SUPERVISOR"
            ],
            "title": "Role"
          },
          "headcount": {
            "type": "integer",
            "title": "Headcount"
          }
        },
        "type": "object",
        "required": [
          "shift",
          "role",
          "headcount"
        ],
        "title": "DemandEntry"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn"
      },
      "MetaOut": {
        "properties": {
          "shifts": {
            "items": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "type": "array",
            "title": "Shifts"
          },
          "roles": {
            "items": {
              "type": "string",
              "enum": [
                "GENERAL_GUARD",
                "SCREENER",
                "SUPERVISOR"
              ]
            },
            "type": "array",
            "title": "Roles"
          },
          "demand": {
            "items": {
              "$ref": "#/components/schemas/DemandEntry"
            },
            "type": "array",
            "title": "Demand"
          },
          "csv_aliases": {
            "$ref": "#/components/schemas/CsvAliasesOut"
          }
        },
        "type": "object",
        "required": [
          "shifts",
          "roles",
          "demand",
          "csv_aliases"
        ],
        "title": "MetaOut"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "app_role": {
            "type": "string",
            "enum": [
              "PLANNER",
              "MANAGER"
            ],
            "title": "App Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "app_role"
        ],
        "title": "UserOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}