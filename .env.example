# Copy to .env and edit to override the demo defaults (optional; §2).
# .env is gitignored. After changing passwords, reset with `docker compose down -v`.

# Demo login passwords (usernames are fixed: planner, manager). Local demo use only.
PLANNER_PASSWORD=planner-demo
MANAGER_PASSWORD=manager-demo

# Signs session cookies. If left empty, the backend generates a random
# secret at startup and logs a warning; sessions then reset on restart.
SESSION_SECRET=dev-session-secret-change-me

# Postgres credentials, used by both the db and backend services.
POSTGRES_USER=icts
POSTGRES_PASSWORD=icts
POSTGRES_DB=icts
